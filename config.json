{
  "mcp": {
    "grok-ai-config": {
      "api_key": "",
      "endpoint": "https://api.x.ai/v1/chat/completions",
      "model": "grok-3",
      "system-prompts": [
        {
          "name": "mcp-delegate",
          "content": "You are an expert in parsing Natural Language Requests into atomic, simple data requests."
        }
      ],
      "startup-prompts": [
        {
          "content": "Initialize MCP context for processing queries."
        },
        {
          "name": "get-kg",
          "content_old": "osdu.owx",
          "content": "https://energyai-team-avanade.azurewebsites.net/data/FedServiceDemo-v001.owx"
        }
      ]
    },
    "mcp-service-config": {
      "api_key": "",
      "endpoint": "https://your-mcp-service.com/api/query"
    },
    "cli-config": {
      "max-tokens": 131072,
      "verbose-mode": 1,
      "max-history": 10,
      "fuzzy-threshold": 70,
      "xml_search_paths": {
        "class_paths": ["Declaration/Class"],
        "subclass_paths": ["SubClassOf"],
        "object_property_paths": ["Declaration/ObjectProperty"],
        "object_property_domain_paths": ["ObjectPropertyDomain"],
        "annotation_paths": ["Annotation"],
        "subobject_property_paths": ["SubObjectPropertyOf"],
        "annotation_assertion_paths": ["AnnotationAssertion"],
        "object_min_cardinality_paths": ["SubClassOf"],
        "object_union_paths": ["ObjectPropertyDomain/ObjectUnionOf"]
      }
    }
  }
}
